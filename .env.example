# Google Gemini Configuration
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_api_key_here

# Gemini Model Configuration
# Model ID for the Gemini model to use (gemini-2.0-flash-exp is recommended)
GEMINI_MODEL_ID=gemini-2.0-flash-exp

# Maximum number of tokens in the generated summary (default: 1024)
MAX_TOKENS=1024

# Temperature controls randomness (0.0 = deterministic, 1.0 = creative, default: 0.5)
TEMPERATURE=0.5
